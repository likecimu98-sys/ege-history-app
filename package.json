{
  "name": "ege-history-app",
  "version": "1.0.0",
  "private": true,
  "description": "Тренажёр ЕГЭ по истории — PWA / Telegram Mini App",
  "scripts": {
    "build:css": "tailwindcss -i ./input.css -o ./output.css",
    "watch:css": "tailwindcss -i ./input.css -o ./output.css --watch",
    "lint:design": "node tools-and-docs/design-lint.js",
    "lint:design:list": "node tools-and-docs/design-lint.js --list",
    "lint:design:update": "node tools-and-docs/design-lint.js --update",
    "test:sw": "node tools-and-docs/service-worker.selftest.js",
    "test:sw-recovery": "node tools-and-docs/sw-recovery.selftest.js",
    "test:bot-repair": "node tools-and-docs/bot-repair.selftest.js",
    "test:duel-cleanup": "node tools-and-docs/duel-cleanup.selftest.js",
    "test:match-fields": "node tools-and-docs/match-fields-contract.selftest.js",
    "test:security-headers": "node tools-and-docs/security-headers.selftest.js",
    "test:homework-table-duel": "node tools-and-docs/homework-table-duel.selftest.js",
    "test:weekly-top": "node tools-and-docs/weekly-top.selftest.js",
    "check": "npm run test:sw && npm run test:sw-recovery && npm run test:bot-repair && npm run test:duel-cleanup && npm run test:match-fields && npm run test:security-headers && npm run test:homework-table-duel && npm run test:weekly-top && npm run test:state-contract && npm run test:scoring && npm run test:bank && npm run lint:design",
    "test:scoring": "node tools-and-docs/exam-scoring.selftest.js",
