# API listens on localhost; Nginx exposes only /api/ and the WebSocket endpoint.
API_HOST=127.0.0.1
API_PORT=8792
PUBLIC_ORIGIN=https://reshay-istoriyu.ru
DATABASE_URL=postgresql://hist_api:CHANGE_ME@127.0.0.1:5432/ege_history
DATABASE_SSL=0

# Existing Telegram bot token; never commit the real value.
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=352253483
INTERNAL_API_TOKEN=

# Server-side Google OAuth (not Firebase Auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reshay-istoriyu.ru/api/v1/auth/google/callback

SESSION_DAYS=90
SESSION_COOKIE=ege_session
CSRF_COOKIE=ege_csrf
MAX_BODY_BYTES=8388608
TRUST_PROXY=1

# Subject "social studies" (stage 2). Off by default: the migration and the API
# ship first, the subject is switched on separately after history is verified.
# While SOCIAL_API=0 every /api/v1/subjects/social/* route answers 404 and never
# touches the database.
SOCIAL_API=0
SOCIAL_ORIGINS=https://obschestvo.reshay-istoriyu.ru
# 0 = unlimited. The subject keeps its own daily counter and never spends the
# history quota.
SOCIAL_FREE_DAILY=0
# Token of the social-studies bot. Telegram user ids are global, so signing in
# through either bot lands in the same account; the API accepts initData signed
# by either token. Empty means that mini app can only use Google or guest.
SOCIAL_BOT_TOKEN=

# Transition only. Remove after the 14-day rollback window.
FIREBASE_SERVICE_ACCOUNT=/root/bot/serviceAccount.json
FIREBASE_APP_ID=ege-history-bot
MIRROR_FIREBASE=0
